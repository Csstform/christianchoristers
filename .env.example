# App
APP_BASE_URL=http://localhost:3000
AUTH_SECRET=replace-with-long-random-string
NODE_ENV=development

# Database
DATABASE_URL=postgres://choristers:choristers@localhost:5432/choristers
POSTGRES_DB=choristers
POSTGRES_USER=choristers
POSTGRES_PASSWORD=choristers
POSTGRES_PORT=5432

# File storage on droplet (local volume)
UPLOADS_DIR=./uploads

# SMTP (Brevo on droplet: smtp-relay.brevo.com:2525)
SMTP_HOST=127.0.0.1
SMTP_PORT=25
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Christian Choristers <noreply@christianchoristers.com>
# Only for local/docker Postfix — never for Brevo/SendGrid
SMTP_IGNORE_TLS=false
SMTP_REQUIRE_TLS=false

# Seed
SEED_ADMIN_EMAIL=admin@christianchoristers.com
SEED_ADMIN_NAME=Site Admin
SEED_SEND_EMAIL=false

# Docker published app port (bound to 127.0.0.1 in compose)
APP_PORT=3000
