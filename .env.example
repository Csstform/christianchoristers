# App
APP_BASE_URL=http://localhost:3000
AUTH_SECRET=replace-with-long-random-string
NODE_ENV=development

# Database
DATABASE_URL=postgres://choristers:choristers@localhost:5432/choristers
POSTGRES_DB=choristers
POSTGRES_USER=choristers
POSTGRES_PASSWORD=choristers
POSTGRES_PORT=5432

# File storage on droplet (local volume)
UPLOADS_DIR=./uploads

# SMTP on droplet
SMTP_HOST=127.0.0.1
SMTP_PORT=25
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Christian Choristers <noreply@christianchoristers.com>

# Seed
SEED_ADMIN_EMAIL=admin@christianchoristers.com
SEED_ADMIN_NAME=Site Admin
SEED_SEND_EMAIL=false

# Docker published app port
APP_PORT=3000
